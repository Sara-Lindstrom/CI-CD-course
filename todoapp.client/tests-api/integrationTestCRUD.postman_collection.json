		{
			"name": "Get by id",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const item = pm.collectionVariables.get(\"todoItem\");\r",
							"if (!item) throw new Error(\"todoItem is not set. Run POST /Todo/add first.\");\r",
							"\r",
							"const todo = typeof item === \"string\" ? JSON.parse(item) : item;\r",
							"\r",
							"if (todo.id === undefined || todo.id === null) {\r",
							"  throw new Error(\"todoItem.id is missing.\");\r",
							"}\r",
							"\r",
							"pm.variables.set(\"todoId\", todo.id);\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"200 OK\", () => {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Returned item matches saved id\", () => {\r",
							"    const item = pm.response.json();\r",
							"    pm.expect(item).to.have.property(\"id\");\r",
							"\r",
							"    pm.expect(item).to.eql(pm.collectionVariables.get(\"todoItem\"));\r",
							"});"

			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"201 Created\", () => {\r",
							"    pm.response.to.have.status(201);\r",
							"\r",
							"    const item = pm.response.json();\r",
							"    pm.expect(item).to.be.an(\"object\");\r",
							"\r",
							"    pm.expect(item).to.have.property(\"id\");\r",
							"    pm.expect(item).to.have.property(\"title\");\r",
							"    pm.expect(item).to.have.property(\"isDone\");\r",
							"    pm.expect(item).to.have.property(\"isUrgent\");\r",
							"    pm.expect(item).to.have.property(\"createdDate\");\r",
							"\r",
							"    pm.expect(item.id).to.be.a(\"number\");\r",
							"    pm.expect(item.title).to.be.a(\"string\").and.to.not.be.empty;\r",
							"    pm.expect(item.title.trim()).to.not.eql(\"\");\r",
							"\r",
							"    pm.collectionVariables.set(\"todoItem\", item);\r",
							"});\r",
							""
